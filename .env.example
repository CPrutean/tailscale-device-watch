# Required: Tailscale API key (https://login.tailscale.com/admin/settings/keys)
TAILSCALE_API_KEY=tskey-api-xxxxx

# Your tailnet name (the part after your email domain, e.g. example.com)
TAILNET=example.com

# Device to watch — matches hostname, device name, or node ID (case-insensitive substring)
WATCH_DEVICE=stolen-laptop

# How often to poll the Tailscale API (seconds). 30–60 is a good balance.
POLL_INTERVAL_SECONDS=30

# Where to persist last-known online state
STATE_FILE=state.json

# --- Notification channels (enable any combination) ---

# Discord incoming webhook URL
DISCORD_WEBHOOK_URL=

# Email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# SMS via Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# Optional: Tailscale webhook secret (for webhook server mode signature verification)
TAILSCALE_WEBHOOK_SECRET=

# Webhook server port (when running `serve` mode)
WEBHOOK_PORT=8080
