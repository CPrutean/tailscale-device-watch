# =============================================================================
# Tailscale Device Watch — example configuration
# =============================================================================
# Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# The watcher loads `.env` from the current working directory by default.
# Use a custom path with:  python -m tailscale_device_watch poll --env-file /path/to/.env
#
# Multiple recipients: separate addresses/URLs/phone numbers with commas,
# semicolons, or newlines in a single variable, or use the *_LIST aliases.
# =============================================================================


# --- Required: Tailscale API -------------------------------------------------
# Create at https://login.tailscale.com/admin/settings/keys
# Use an API access token (starts with tskey-api-), NOT an auth key (tskey-auth-).
# Requires Owner, Admin, IT admin, or Network admin role. Expires in 1–90 days.

TAILSCALE_API_KEY=tskey-api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your tailnet name — usually your email domain (e.g. example.com).
# Visible in the admin console URL or Settings → General.

TAILNET=example.com

# Device to watch — case-insensitive substring match against hostname, device
# name, node ID, or Tailscale IP. Must match exactly ONE device in your tailnet.

WATCH_DEVICE=stolen-laptop


# --- Polling -----------------------------------------------------------------

# Seconds between Tailscale API polls (minimum 10). 30–60 is a good balance.

POLL_INTERVAL_SECONDS=30

# JSON file storing last-known online state (relative paths are from cwd).

STATE_FILE=state.json


# --- Notifications (enable any combination) ----------------------------------
# At least one channel should be configured. All configured channels fire on
# each alert. Failures on one channel do not block the others.

# Discord — one or more incoming webhook URLs (comma/semicolon/newline separated).
# Create in Discord: Server Settings → Integrations → Webhooks.

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz
# DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/111/aaa,https://discord.com/api/webhooks/222/bbb

# Email — SMTP settings. ALERT_EMAIL_TO accepts multiple addresses.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=alerts@example.com
ALERT_EMAIL_TO=you@example.com,partner@example.com,security@example.com
# ALERT_EMAIL_TO_LIST=you@example.com
#                  partner@example.com

# SMS — Twilio (https://www.twilio.com). All four Twilio vars required for SMS.
# ALERT_SMS_TO accepts multiple E.164 numbers (comma/semicolon/newline separated).

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
ALERT_SMS_TO=+15559876543,+15551112222
# ALERT_SMS_TO_LIST=+15559876543
#                +15551112222


# --- Optional: Tailscale webhook receiver (serve / both modes) ---------------
# Secret from Tailscale admin when creating a webhook endpoint.
# If set, incoming POST /tailscale-webhook requests are signature-verified.

TAILSCALE_WEBHOOK_SECRET=

# HTTP port for the webhook server.

WEBHOOK_PORT=8080


# --- Recovery intelligence ---------------------------------------------------
# The watcher host should be enrolled on your tailnet with the tailscale CLI
# installed. On alert, the watcher gathers endpoints, GeoIP, posture country,
# and runs one tailscale ping to confirm reachability.

TAILSCALE_PING_ENABLED=true
TAILSCALE_PING_COUNT=3
TAILSCALE_PING_TIMEOUT_SECONDS=5
TAILSCALE_CLI=tailscale

# Resolve public endpoint IPs to city/region via ip-api.com (no API key required).

GEOIP_ENABLED=true
